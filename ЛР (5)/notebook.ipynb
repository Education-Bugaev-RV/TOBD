    "               marker='o', edgecolors='darkgray', linewidth=0.8)\n",
    "    \n",
    "    # Тестовые данные для каждого класса\n",
    "    mask_test = y_test == class_label\n",
    "    plt.scatter(X_test[mask_test, 0], X_test[mask_test, 1], \n",
