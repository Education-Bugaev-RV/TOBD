    "## Задание 4"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "3865d7cc",
   "metadata": {},
   "source": [
    "### Формулировка\n",
    "\n",
    "Проанализировать и визуализировать ошибки классификации kNN:\n",
    "1. Идентифицировать неправильно классифицированные точки\n",
    "2. Выделить эти точки на графике\n",
    "3. Построить график с выделением правильных и неправильных предсказаний\n",
    "4. Показать границы принятия решений\n",
    "5. Вывести статистику ошибок"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1424622a",
   "metadata": {},
   "source": [
    "### Решение"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "4a",
   "metadata": {},
   "source": [
    "#### 4.1 Идентификация неправильно классифицированных точек"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9cd8e359",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Идентификация неправильно классифицированных точек\n",
    "print(\"=== ИДЕНТИФИКАЦИЯ ОШИБОК КЛАССИФИКАЦИИ ===\")\n",
    "\n",
    "# Найти индексы неправильно классифицированных образцов\n",
    "misclassified_mask = y_test != y_pred\n",
    "misclassified_indices = np.where(misclassified_mask)[0]\n",
    "correctly_classified_indices = np.where(~misclassified_mask)[0]\n",
    "\n",
    "print(f\"Всего тестовых образцов: {len(y_test)}\")\n",
    "print(f\"Правильно классифицировано: {len(correctly_classified_indices)} ({len(correctly_classified_indices)/len(y_test)*100:.1f}%)\")\n",
    "print(f\"Неправильно классифицировано: {len(misclassified_indices)} ({len(misclassified_indices)/len(y_test)*100:.1f}%)\")\n",
    "\n",
    "# Детальный анализ ошибок\n",
    "print(\"\\n--- ДЕТАЛЬНЫЙ АНАЛИЗ ОШИБОК ---\")\n",
    "if len(misclassified_indices) > 0:\n",
    "    print(\"Индексы неправильно классифицированных точек:\")\n",
    "    print(misclassified_indices)\n",
    "    \n",
    "    print(\"\\nДетали ошибок:\")\n",
    "    for i, idx in enumerate(misclassified_indices):\n",
    "        true_class = y_test[idx]\n",
    "        pred_class = y_pred[idx]\n",
    "        confidence = np.max(y_pred_proba[idx])\n",
    "        print(f\"  Образец {idx}: Истинный класс {true_class} → Предсказан класс {pred_class} (уверенность: {confidence:.3f})\")\n",
    "        \n",
    "        if i >= 9:  # Показать только первые 10 ошибок\n",
    "            remaining = len(misclassified_indices) - 10\n",
    "            if remaining > 0:\n",
    "                print(f\"  ... и еще {remaining} ошибок\")\n",
    "            break\n",
    "    \n",
    "    # Анализ типов ошибок\n",
    "    print(\"\\n--- АНАЛИЗ ТИПОВ ОШИБОК ---\")\n",
    "    unique_classes = np.unique(y_test)\n",
    "    for true_class in unique_classes:\n",
    "        for pred_class in unique_classes:\n",
    "            if true_class != pred_class:\n",
    "                error_count = np.sum((y_test == true_class) & (y_pred == pred_class))\n",
    "                if error_count > 0:\n",
    "                    total_true_class = np.sum(y_test == true_class)\n",
    "                    error_rate = error_count / total_true_class * 100\n",
    "                    print(f\"  Класс {true_class} → Класс {pred_class}: {error_count} ошибок ({error_rate:.1f}% от класса {true_class})\")\n",
    "    \n",
    "    # Анализ уверенности для ошибочных предсказаний\n",
    "    print(\"\\n--- АНАЛИЗ УВЕРЕННОСТИ ОШИБОЧНЫХ ПРЕДСКАЗАНИЙ ---\")\n",
    "    misclassified_confidences = np.max(y_pred_proba[misclassified_indices], axis=1)\n",
    "    correctly_classified_confidences = np.max(y_pred_proba[correctly_classified_indices], axis=1)\n",
    "    \n",
    "    print(f\"Средняя уверенность правильных предсказаний: {np.mean(correctly_classified_confidences):.4f}\")\n",
    "    print(f\"Средняя уверенность ошибочных предсказаний: {np.mean(misclassified_confidences):.4f}\")\n",
    "    print(f\"Разница в уверенности: {np.mean(correctly_classified_confidences) - np.mean(misclassified_confidences):.4f}\")\n",
    "    \n",
    "    # Подсчет ошибок с высокой уверенностью\n",
    "    high_confidence_errors = np.sum(misclassified_confidences > 0.7)\n",
    "    print(f\"\\nОшибки с высокой уверенностью (>0.7): {high_confidence_errors} из {len(misclassified_indices)}\")\n",
    "    \n",
    "else:\n",
