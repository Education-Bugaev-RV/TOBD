    "f1_per_class = f1_score(y_test, y_pred, average=None)\n",
    "\n",
    "print(\"\\n--- ОБЩИЕ МЕТРИКИ (WEIGHTED AVERAGE) ---\")\n",
    "print(f\"Accuracy (Точность):  {accuracy:.4f}\")\n",
